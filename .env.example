# Copy to .env and replace placeholders. Never commit .env.
# No real secrets belong in git or chat.

EDGE_PORT=8080

SIGNUP_DB_USER=signup
SIGNUP_DB_PASSWORD=change-me-signup-db

LOGIN_DB_USER=login
LOGIN_DB_PASSWORD=change-me-login-db

# Must be at least 32 characters (login-service boot fails otherwise).
JWT_SECRET=change-me-use-at-least-32-chars!!

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Reserved for future internal verify header checks (Sentinel/Anvil).
# Today /internal/** is blocked at the edge and reachable only on auth_net.
INTERNAL_API_KEY=change-me-internal-api-key
