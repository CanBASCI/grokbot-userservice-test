# api-gateway — public HTTP 8080; gRPC clients only. Maven ≥ 3.9.11.
FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
COPY auth-proto auth-proto
COPY signup-service/pom.xml signup-service/pom.xml
COPY login-service/pom.xml login-service/pom.xml
COPY api-gateway api-gateway
RUN mvn -B -pl api-gateway -am -Dmaven.test.skip=true package \
    && cp api-gateway/target/api-gateway-0.1.0-SNAPSHOT.jar /build/app.jar

FROM eclipse-temurin:25-jre
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app
COPY --from=build /build/app.jar /app/app.jar
USER app
ENV SERVER_PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
